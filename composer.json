{
    "name": "monkeyscloud/monkeyslegion-testing",
    "description": "Testing toolkit for MonKeysLegion — HTTP testing DSL, database traits, fake subsystems, snapshots.",
    "license": "MIT",
    "type": "library",
    "require": {
        "monkeyscloud/monkeyslegion-auth": "^2.2",
        "monkeyscloud/monkeyslegion-cli": "^2.1",
        "monkeyscloud/monkeyslegion-core": "^2.1",
        "monkeyscloud/monkeyslegion-database": "^2.2",
        "monkeyscloud/monkeyslegion-di": "^2.0",
        "monkeyscloud/monkeyslegion-http": "^2.1",
        "monkeyscloud/monkeyslegion-mail": "^2.0",
        "monkeyscloud/monkeyslegion-queue": "^2.0",
        "monkeyscloud/monkeyslegion-router": "^2.2",
        "php": ">=8.4",
        "phpunit/phpunit": "^11.0"
    },
    "require-dev": {
        "monkeyscloud/monkeyslegion-migration": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MonkeysLegion\\Testing\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MonkeysLegion\\Testing\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true
}
